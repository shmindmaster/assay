{
  "name": "assay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The agent drafts. Software decides. A runnable reference implementation of the deterministic control layer for AI agents.",
  "author": "Sarosh Hussain",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
